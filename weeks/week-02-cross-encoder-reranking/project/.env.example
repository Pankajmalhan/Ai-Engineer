DATABASE_URL=postgresql://rerank:rerank@localhost:5434/rerank_bench
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RRF_K=60
RERANK_POOL_SIZE=25
FINAL_TOP_K=10

# Optional -- leave unset to run the benchmark with the BGE reranker only.
# Get a free trial key at https://dashboard.cohere.com/api-keys (no credit
# card required; trial keys are rate-limited but plenty for a 20-query run).
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5

BGE_RERANKER_MODEL=BAAI/bge-reranker-base
